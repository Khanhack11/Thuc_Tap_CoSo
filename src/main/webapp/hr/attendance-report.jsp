<div class="container-fluid py-4"><div class="alert alert-warning" role="status">API báo cáo chuyên cần dạng JSON chưa được cung cấp. Bộ lọc không thể truy vấn dữ liệu thật nên hiện không khả dụng.</div></div><%@ include file="/WEB-INF/views/common/footer.jsp" %>

<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Báo cáo chuyên cần"/><c:set var="activePage" value="attendance-report"/><%@ include file="/WEB-INF/views/common/header.jsp" %>
<div class="container-fluid py-4"><h2 class="h4">Báo cáo chuyên cần</h2><p class="text-muted">Theo dõi đi làm, nghỉ phép, vắng và thiếu check-out.</p><form id="f" class="card card-body mb-4 row g-3 flex-row align-items-end"><div class="col-sm-6 col-lg-2"><label class="form-label">Từ ngày</label><input class="form-control" name="from" type="date" required></div><div class="col-sm-6 col-lg-2"><label class="form-label">Đến ngày</label><input class="form-control" name="to" type="date" required></div><div class="col-sm-6 col-lg-2"><label class="form-label">Mã chương trình</label><input class="form-control" name="programId" type="number" min="1"></div><div class="col-sm-6 col-lg-2"><label class="form-label">Mã ghi danh / TTS</label><input class="form-control" name="enrollmentId" type="number" min="1"></div><div class="col-sm-6 col-lg-2"><label class="form-label">Trạng thái</label><select class="form-select" name="status"><option value="">Tất cả</option><option value="PRESENT">Đi làm</option><option value="MISSING_CHECKOUT">Thiếu check-out</option><option value="LEAVE">Nghỉ phép</option><option value="ABSENT">Vắng</option></select></div><div class="col-sm-6 col-lg-2"><button class="btn btn-primary w-100">Lọc</button></div></form><div id="err" class="alert alert-danger d-none"></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Ngày</th><th>Thực tập sinh</th><th>Chương trình</th><th>Check-in</th><th>Check-out</th><th>Giờ làm</th><th>Trạng thái</th><th></th></tr></thead><tbody id="rows"></tbody></table></div></div></div><script>(()=>{const ctx='${pageContext.request.contextPath}',f=document.getElementById('f'),rows=document.getElementById('rows'),err=document.getElementById('err');const esc=v=>String(v??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const names={PRESENT:['Đi làm','text-bg-success'],MISSING_CHECKOUT:['Thiếu check-out','text-bg-danger'],LEAVE:['Nghỉ phép','text-bg-info'],ABSENT:['Vắng mặt','text-bg-warning']};async function load(){let q=new URLSearchParams(new FormData(f));try{let r=await fetch(ctx+'/hr/attendance?'+q,{credentials:'same-origin'});if(!r.ok)throw Error(r.status===403?'Bạn không có quyền xem báo cáo.':'Không tải được báo cáo.');let t=await r.text(),source=new DOMParser().parseFromString(t,'text/html').querySelector('[data-attendance-json]');if(!source)throw Error('BE chưa trả payload JSON cho báo cáo HR tại /hr/attendance.');let data=JSON.parse(source.textContent||'[]');rows.innerHTML=data.map((x,i)=>{let n=names[x.status]||[x.status,'text-bg-secondary'];return `<tr><td>${esc(x.workDate)}</td><td><b>${esc(x.internName)}</b><div class="small text-muted">#${esc(x.enrollmentId)}</div></td><td>${esc(x.programName)}</td><td>${esc(x.checkInTime)}</td><td>${x.status==='MISSING_CHECKOUT'?'<b class="text-danger">Chưa check-out</b>':esc(x.checkOutTime)}</td><td>${Number(x.workedHours||0).toFixed(2)}</td><td><span class="badge ${n[1]}">${n[0]}</span></td><td><button class="btn btn-sm btn-outline-primary" data-i="${i}">Chi tiết</button></td></tr><tr id="d${i}" class="d-none bg-light"><td colspan="8">Lịch: ${esc(x.startTime)} – ${esc(x.endTime)} · Nghỉ phép duyệt: ${x.approvedLeave?'Có':'Không'} · Tổng giờ: ${Number(x.workedHours||0).toFixed(2)}</td></tr>`}).join('')||'<tr><td colspan="8" class="text-center text-muted">Không có dữ liệu.</td></tr>';err.className='alert alert-danger d-none';rows.querySelectorAll('[data-i]').forEach(b=>b.onclick=()=>document.getElementById('d'+b.dataset.i).classList.toggle('d-none'))}catch(e){rows.innerHTML='<tr><td colspan="8" class="text-center text-danger">Không tải được báo cáo.</td></tr>';err.textContent=e.message;err.className='alert alert-danger'}}f.onsubmit=e=>{e.preventDefault();load()};let now=new Date(),iso=d=>new Date(d-d.getTimezoneOffset()*6e4).toISOString().slice(0,10);f.from.value=iso(new Date(now-30*864e5));f.to.value=iso(now);load()})();</script><%@ include file="/WEB-INF/views/common/footer.jsp" %>
