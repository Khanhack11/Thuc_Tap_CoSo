<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Nhật ký hoạt động"/><c:set var="activePage" value="audit-logs"/><%@ include file="/WEB-INF/views/common/header.jsp" %>
<c:choose><c:when test="${sessionScope.currentRole ne 'ADMIN'}"><div class="container py-5"><div class="alert alert-danger">Bạn không có quyền xem nhật ký hoạt động.</div></div></c:when><c:otherwise><div class="container-fluid py-4"><h2 class="h4">Nhật ký hoạt động <span class="badge text-bg-dark">ADMIN</span></h2><p class="text-muted">Lọc và tra cứu lịch sử thao tác hệ thống.</p><form id="f" class="card card-body mb-3 row g-2 flex-row flex-wrap"><input class="form-control col" name="actorUserId" type="number" min="1" placeholder="Mã người dùng"><input class="form-control col" name="action" maxlength="64" placeholder="Hoạt động (LOGIN)"><input class="form-control col" name="objectType" maxlength="64" placeholder="Đối tượng (USER)"><select class="form-select col" name="result"><option value="">Mọi kết quả</option><option>SUCCESS</option><option>FAILURE</option></select><input class="form-control col" name="from" type="date"><input class="form-control col" name="to" type="date"><button class="btn btn-primary col-auto">Lọc</button><button type="reset" class="btn btn-outline-secondary col-auto">Xóa</button></form><div id="err" class="alert alert-danger d-none"></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Thời gian</th><th>Người thực hiện</th><th>Hoạt động</th><th>Đối tượng / ID</th><th>Kết quả</th></tr></thead><tbody id="rows"></tbody></table></div><div class="card-footer d-flex justify-content-between"><small id="sum"></small><span><button id="prev" class="btn btn-sm btn-outline-secondary">Trước</button> <button id="next" class="btn btn-sm btn-outline-secondary">Sau</button></span></div></div></div><script>(()=>{const c='${pageContext.request.contextPath}',f=document.getElementById('f'),r=document.getElementById('rows'),e=document.getElementById('err'),s=document.getElementById('sum');let p=1,total=0;const x=v=>String(v??'—').replace(/[&<>"']/g,a=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[a]));async function load(){let q=new URLSearchParams(new FormData(f));q.set('page',p);q.set('size',20);['from','to'].forEach(k=>{if(q.get(k))q.set(k,new Date(q.get(k)+'T00:00:00+07:00').toISOString())});try{let z=await fetch(c+'/admin/audit-logs?'+q),d=await z.json();if(!z.ok)throw Error(d.error);total=d.total||0;r.innerHTML=(d.items||[]).map(a=>`<tr><td>${x(new Date(a.occurredAt).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'}))}</td><td>${a.actorUserId==null?'Hệ thống':'#'+x(a.actorUserId)}</td><td><b>${x(a.action)}</b></td><td>${x(a.objectType)} / ${x(a.objectId)}</td><td><span class="badge ${a.result==='SUCCESS'?'text-bg-success':'text-bg-danger'}">${x(a.result)}</span></td></tr>`).join('')||'<tr><td colspan="5" class="text-center text-muted">Không có dữ liệu.</td></tr>';s.textContent=`Trang ${p} · ${total} bản ghi`;prev.disabled=p<=1;next.disabled=p*20>=total;e.classList.add('d-none')}catch(t){e.textContent=t.message||'Không tải được nhật ký';e.classList.remove('d-none')}}f.onsubmit=t=>{t.preventDefault();p=1;load()};f.onreset=()=>setTimeout(()=>{p=1;load()},0);prev.onclick=()=>{if(p>1){p--;load()}};next.onclick=()=>{if(p*20<total){p++;load()}};load()})();</script></c:otherwise></c:choose><%@ include file="/WEB-INF/views/common/footer.jsp" %>
