<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Lịch họp"/><c:set var="activePage" value="meetings"/><%@ include file="/WEB-INF/views/common/header.jsp" %>
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h4">Lịch họp</h2><p class="text-muted mb-0">Tạo, sửa, hủy cuộc họp và chọn người tham gia theo chương trình.</p></div><button class="btn btn-primary" id="new">Tạo lịch họp</button></div><div id="msg" class="alert d-none"></div><section class="card mb-4"><div class="card-body"><form id="form" class="row g-3"><input type="hidden" name="id"><input type="hidden" name="revision"><div class="col-md-6"><label class="form-label">Chương trình *</label><input class="form-control" name="programId" type="number" min="1" required></div><div class="col-md-6"><label class="form-label">Tiêu đề *</label><input class="form-control" name="title" maxlength="200" required></div><div class="col-md-6"><label class="form-label">Bắt đầu *</label><input class="form-control" name="startsAt" type="datetime-local" required></div><div class="col-md-6"><label class="form-label">Kết thúc *</label><input class="form-control" name="endsAt" type="datetime-local" required></div><div class="col-md-6"><label class="form-label">Địa điểm *</label><input class="form-control" name="location" maxlength="500" required></div><div class="col-md-6"><label class="form-label">Enrollment IDs *</label><input class="form-control" name="enrollmentIds" placeholder="101,102" required></div><div class="col-12"><label class="form-label">Mô tả</label><textarea class="form-control" name="description" rows="2"></textarea></div><div class="col-12"><button class="btn btn-primary">Lưu</button> <button type="button" id="cancel" class="btn btn-outline-danger d-none">Hủy cuộc họp</button></div></form></div></section><section class="card"><div class="table-responsive"><table class="table table-hover"><thead class="table-light"><tr><th>Tiêu đề</th><th>Thời gian</th><th>CT</th><th>Trạng thái</th><th>Email</th><th></th></tr></thead><tbody id="rows"></tbody></table></div></section></div><script>(()=>{const c='${pageContext.request.contextPath}',f=document.getElementById('form'),rows=document.getElementById('rows'),msg=document.getElementById('msg');let token='';const field=n=>f.elements[n],say=(t,b)=>{msg.textContent=t;msg.className='alert alert-'+(b?'danger':'success')};const iso=v=>v?new Date(v).toISOString():'';async function load(){let r=await fetch(c+'/meetings?size=100'),d=await r.json();token=d.csrfToken||token;rows.innerHTML=(d.items||[]).map(m=>`<tr><td>${m.title}</td><td>${new Date(m.startsAt).toLocaleString('vi-VN')} – ${new Date(m.endsAt).toLocaleTimeString('vi-VN')}</td><td>#${m.programId}</td><td><span class="badge ${m.status==='CANCELLED'?'text-bg-secondary':'text-bg-success'}">${m.status}</span></td><td><span class="badge text-bg-info">${m.status==='CANCELLED'?'Không gửi':'Theo cấu hình server'}</span></td><td><button class="btn btn-sm btn-outline-primary" data-id="${m.id}">Sửa</button></td></tr>`).join('')||'<tr><td colspan="6" class="text-center text-muted">Chưa có lịch họp.</td></tr>'}async function detail(id){let d=await(await fetch(c+'/meetings?id='+id)).json(),m=d.item;token=d.csrfToken||token;Object.keys(m).forEach(k=>{if(field(k))field(k).value=Array.isArray(m[k])?m[k].join(','):m[k]});field('startsAt').value=m.startsAt.slice(0,16);field('endsAt').value=m.endsAt.slice(0,16);document.getElementById('cancel').classList.toggle('d-none',m.status==='CANCELLED')}async function post(data){let r=await fetch(c+'/meetings',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({...data,csrfToken:token})}),d=await r.json();if(!r.ok)throw Error(d.error||'Không thể lưu')}f.onsubmit=async e=>{e.preventDefault();try{let x=Object.fromEntries(new FormData(f));x.action=x.id?'update':'create';x.startsAt=iso(x.startsAt);x.endsAt=iso(x.endsAt);await post(x);say('Đã lưu lịch họp. Email được xử lý bởi worker server, không lộ SMTP client.',false);f.reset();field('id').value='';document.getElementById('cancel').classList.add('d-none');load()}catch(e){say(e.message,true)}};rows.onclick=e=>{let b=e.target.closest('[data-id]');if(b)detail(b.dataset.id)};document.getElementById('new').onclick=()=>{f.reset();field('id').value='';document.getElementById('cancel').classList.add('d-none')};document.getElementById('cancel').onclick=async()=>{if(!confirm('Hủy cuộc họp này?'))return;try{await post({action:'cancel',id:field('id').value,revision:field('revision').value});say('Đã hủy cuộc họp.',false);load()}catch(e){say(e.message,true)}};load()})();</script><%@ include file="/WEB-INF/views/common/footer.jsp" %>
